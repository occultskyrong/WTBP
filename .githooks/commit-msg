#!/usr/bin/env bash
set -euo pipefail

message_file="${1:?commit message file is required}"
subject="$(sed -n '1p' "$message_file")"

case "$subject" in
  Merge\ *|Revert\ *)
    exit 0
    ;;
esac

if [[ -z "$subject" ]]; then
  printf '提交标题不能为空。\n' >&2
  exit 1
fi

if [[ "$(printf '%s' "$subject" | wc -m | tr -d ' ')" -gt 72 ]]; then
  printf '提交标题不得超过 72 个字符。\n' >&2
  exit 1
fi

pattern='^(feat|fix|docs|refactor|test|chore|ci|build|perf)(\([a-z0-9][a-z0-9._/-]*\))?!?: [^[:space:]].*$'
if ! printf '%s\n' "$subject" | LC_ALL=C grep -Eq "$pattern"; then
  cat >&2 <<'EOF'
提交标题格式不正确。请使用 Conventional Commits：
  <type>(<optional-scope>): <summary>

示例：
  feat(practice): 增加数据库建模实践
  ci: 校验提交标题格式
  docs!: 调整贡献约定
EOF
  exit 1
fi

current_version="$(git show :VERSION 2>/dev/null | tr -d '[:space:]' || true)"
base_version="$(git show HEAD:VERSION 2>/dev/null | tr -d '[:space:]' || printf '0.0.0')"
if [[ "$current_version" =~ ^([0-9]+)\.([0-9]+)\.[0-9]+$ ]]; then
  current_major="${BASH_REMATCH[1]}"
  if [[ "$base_version" =~ ^([0-9]+)\.([0-9]+)\.[0-9]+$ ]]; then
    base_major="${BASH_REMATCH[1]}"
  else
    base_major=0
  fi
  if [[ "$current_major" -gt "$base_major" ]]; then
    if ! printf '%s\n' "$subject" | rg -q '^[a-z]+(\([a-z0-9][a-z0-9._/-]*\))?!:' && ! rg -q '^BREAKING CHANGE:' "$message_file"; then
      printf 'MAJOR 版本升级必须使用 Conventional Commit 的 ! 或在正文声明 BREAKING CHANGE。\n' >&2
      exit 1
    fi
  fi
fi
