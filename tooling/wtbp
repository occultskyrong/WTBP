#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link_target="$(readlink "$script_path")"
  if [[ "$link_target" == /* ]]; then
    script_path="$link_target"
  else
    script_path="$script_dir/$link_target"
  fi
done
repo_root="$(cd "$(dirname "$script_path")/.." && pwd)"
route_file="$repo_root/knowledge/skill-routes.yaml"
index_file="$repo_root/knowledge/skill-index.yaml"
external_capability_file="$repo_root/knowledge/external-capabilities.yaml"
external_source_file="$repo_root/knowledge/external-sources.yaml"

fail() {
  printf 'WTBP 路由失败：%s\n' "$1" >&2
  exit 2
}

usage() {
  cat <<'EOF'
用法：
  wtbp                              # 列出可用 Skill
  wtbp root                         # 输出 WTBP 仓库根目录
  wtbp list --domain <domain>        # 按领域浏览 Skill
  wtbp show <skill-id>               # 查看 Skill 能力卡
  wtbp external                      # 列出已登记的外部能力及采用边界
  wtbp "<问题或任务>"                # 输出本地 Skill 与外部能力候选及可解释匹配依据
  wtbp install <skill-id>            # 安装已登记的外部 Skill

当前会话负责基于候选能力卡进行语义判断；本命令不会启动第二个 LLM 会话。
候选查询不会自动安装、执行 Skill 或访问外部服务。外部能力卡只说明复用方式；只有受控安装路由才可在确认后显式运行 `wtbp install <skill-id>`。
在当前 Agent/Claude 对话中输入 `wtbp，收集 <公开 URL>` 即授权收录：当前会话会读取公开来源、生成未安装的最佳实践卡并完成校验。
EOF
}

[[ -f "$route_file" ]] || fail '缺少 knowledge/skill-routes.yaml'
[[ -f "$index_file" ]] || fail '缺少 knowledge/skill-index.yaml'
[[ -f "$external_capability_file" ]] || fail '缺少 knowledge/external-capabilities.yaml'
[[ -f "$external_source_file" ]] || fail '缺少 knowledge/external-sources.yaml'

source_metadata() {
  local requested_id="$1"

  awk -F': ' -v requested_id="$requested_id" '
    function emit() {
      if (id == requested_id) {
        print url "\t" publisher "\t" trust "\t" accessed_on "\t" license "\t" revision "\t" skill_path "\t" quality_evidence
        found = 1
      }
    }
    /^  - id: / { emit(); id = $2; url = publisher = trust = accessed_on = license = revision = skill_path = quality_evidence = ""; next }
    /^    url: / { url = $2 }
    /^    publisher: / { publisher = $2 }
    /^    trust: / { trust = $2 }
    /^    accessed_on: / { accessed_on = $2 }
    /^    license: / { license = $2 }
    /^    revision: / { revision = $2 }
    /^    skill_path: / { skill_path = $2 }
    /^    quality_evidence: / { quality_evidence = $2 }
    END { emit(); exit(found ? 0 : 1) }
  ' "$external_source_file"
}

show_external_source() {
  local source_id="$1"
  local source_url source_publisher source_trust source_accessed_on source_license source_revision source_skill_path source_quality_evidence

  IFS=$'\t' read -r source_url source_publisher source_trust source_accessed_on source_license source_revision source_skill_path source_quality_evidence <<< "$(source_metadata "$source_id")" || true
  [[ -n "${source_url:-}" ]] || fail "外部能力引用的来源不存在：$source_id"
  printf '%s\n' '- 来源：'
  printf '%s\n' "  URL：$source_url"
  printf '%s\n' "  发布方：${source_publisher}｜可信级别：${source_trust}｜访问日期：${source_accessed_on}"
  printf '%s\n' "  许可证：$source_license"
  printf '%s\n' "  修订：$source_revision"
  printf '%s\n' "  Skill 路径：$source_skill_path"
  printf '%s\n' "  质量证据：$source_quality_evidence"
}

list_skills() {
  local domain="${1:-}"

  awk -F': ' -v domain="$domain" '
    function clean(value) { sub(/^\[/, "", value); sub(/\]$/, "", value); return value }
    function has_domain(value, expected) { value = clean(value); gsub(/[[:space:]]/, "", value); return expected == "" || ("," value ",") ~ ("," expected ",") }
    function emit() { if (id != "" && has_domain(domains, domain)) print id "\t" title "\t" summary "\t" domains "\t" stages "\t" status }
    /^  - id: / { emit(); id = $2; title = summary = domains = stages = status = ""; next }
    /^    title: / { title = $2 }
    /^    summary: / { summary = $2 }
    /^    domains: / { domains = $2 }
    /^    stages: / { stages = $2 }
    /^    status: / { status = $2 }
    END { emit() }
  ' "$index_file" | while IFS=$'\t' read -r skill_id title summary domains stages status; do
    domains="${domains#[}"; domains="${domains%]}"; domains="${domains//, /、}"
    stages="${stages#[}"; stages="${stages%]}"; stages="${stages//, /、}"
    printf '%s\n' "- ${skill_id}（${status}）"
    printf '  %s｜领域：%s｜阶段：%s\n' "$title" "$domains" "$stages"
    printf '  %s\n' "$summary"
  done
}

show_skill() {
  local requested_id="$1"
  local skill_path

  skill_path="$(awk -v skill_id="$requested_id" '
    $0 == "  - id: " skill_id { found = 1; next }
    found && /^    path: / { print $2; exit }
    found && /^  - id: / { exit }
  ' "$repo_root/knowledge/catalog.yaml")"
  awk -F': ' -v requested_id="$requested_id" '
    function emit() {
      if (id != requested_id) return
      print "# " title " (`" id "`)"
      print ""
      print summary
      print ""
      print "- 状态：" status
      print "- 领域：" domains
      print "- 阶段：" stages
      print "- 核心能力：" capabilities
      print "- 输入：" inputs
      print "- 输出：" outputs
      print "- 副作用：" side_effects
      print "- 安装：" install
      print "- 别名：" aliases
      print "- 关联路由：" route_ids
      found = 1
    }
    /^  - id: / { emit(); id = $2; title = summary = domains = capabilities = stages = inputs = outputs = side_effects = status = install = aliases = route_ids = ""; next }
    /^    title: / { title = $2 }
    /^    summary: / { summary = $2 }
    /^    domains: / { domains = $2 }
    /^    capabilities: / { capabilities = $2 }
    /^    stages: / { stages = $2 }
    /^    inputs: / { inputs = $2 }
    /^    outputs: / { outputs = $2 }
    /^    side_effects: / { side_effects = $2 }
    /^    status: / { status = $2 }
    /^    install: / { install = $2 }
    /^    aliases: / { aliases = $2 }
    /^    route_ids: / { route_ids = $2 }
    END { emit(); exit(found ? 0 : 1) }
  ' "$index_file" && {
    [[ -n "$skill_path" ]] && printf '%s\n' "- 规范文件：$skill_path/SKILL.md"
    return 0
  }

  show_external_capability "$requested_id" || fail "未找到 Skill 或外部能力：$requested_id"
}

list_external_capabilities() {
  local domain="${1:-}"

  awk -F': ' -v domain="$domain" '
    function clean(value) { sub(/^\[/, "", value); sub(/\]$/, "", value); return value }
    function has_domain(value, expected) { value = clean(value); gsub(/[[:space:]]/, "", value); return expected == "" || ("," value ",") ~ ("," expected ",") }
    function emit() { if (id != "" && has_domain(domains, domain)) print id "\t" title "\t" summary "\t" adoption "\t" availability "\t" status }
    /^  - id: / { emit(); id = title = summary = domains = adoption = availability = status = ""; id = $2; next }
    /^    title: / { title = $2 }
    /^    summary: / { summary = $2 }
    /^    domains: / { domains = $2 }
    /^    adoption: / { adoption = $2 }
    /^    availability: / { availability = $2 }
    /^    status: / { status = $2 }
    END { emit() }
  ' "$external_capability_file" | while IFS=$'\t' read -r capability_id title summary adoption availability status; do
    printf '%s\n' "- ${capability_id}（${status}）"
    printf '  %s｜采用：%s｜可用性：%s\n' "$title" "$adoption" "$availability"
    printf '  %s\n' "$summary"
  done
}

show_external_capability() {
  local requested_id="$1"
  local source_id

  source_id="$(awk -v requested_id="$requested_id" '
    $0 == "  - id: " requested_id { found = 1; next }
    found && /^    source_id: / { print $2; exit }
    found && /^  - id: / { exit }
  ' "$external_capability_file")"
  [[ -n "$source_id" ]] || return 1

  awk -F': ' -v requested_id="$requested_id" '
    function emit() {
      if (id != requested_id) return
      print "# " title " (`" id "`)"
      print ""
      print summary
      print ""
      print "- 类型：" kind
      print "- 来源 ID：" source_id
      print "- 状态：" status
      print "- 领域：" domains
      print "- 核心能力：" capabilities
      print "- 阶段：" stages
      print "- 解决问题：" solves
      print "- 不适用：" not_for
      print "- 适用场景：" scenarios
      print "- 典型 Case：" cases
      print "- 输入：" inputs
      print "- 输出：" outputs
      print "- 技术：" technologies
      print "- 目标：" targets
      print "- 采用方式：" adoption
      print "- 可用性：" availability
      print "- 安装状态：" installation_status
      print "- 权限边界：" permissions
      print "- 验证方式：" verify
      print "- 关键词：" keywords
      found = 1
    }
    /^  - id: / { emit(); id = $2; title = summary = source_id = kind = domains = capabilities = stages = solves = not_for = scenarios = cases = inputs = outputs = technologies = targets = adoption = availability = installation_status = permissions = verify = status = keywords = ""; next }
    /^    title: / { title = $2 }
    /^    summary: / { summary = $2 }
    /^    source_id: / { source_id = $2 }
    /^    kind: / { kind = $2 }
    /^    domains: / { domains = $2 }
    /^    capabilities: / { capabilities = $2 }
    /^    stages: / { stages = $2 }
    /^    solves: / { solves = $2 }
    /^    not_for: / { not_for = $2 }
    /^    scenarios: / { scenarios = $2 }
    /^    cases: / { cases = $2 }
    /^    inputs: / { inputs = $2 }
    /^    outputs: / { outputs = $2 }
    /^    technologies: / { technologies = $2 }
    /^    targets: / { targets = $2 }
    /^    adoption: / { adoption = $2 }
    /^    availability: / { availability = $2 }
    /^    installation_status: / { installation_status = $2 }
    /^    permissions: / { permissions = $2 }
    /^    verify: / { verify = $2 }
    /^    status: / { status = $2 }
    /^    keywords: / { keywords = $2 }
    END { emit(); exit(found ? 0 : 1) }
  ' "$external_capability_file"
  show_external_source "$source_id"
}

external_next_step() {
  local adoption="$1"
  local capability_id="$2"

  case "$adoption" in
    direct-use)
      printf '当前会话确认客户端可用性与权限后可直接复用；无需 wtbp install。\n'
      ;;
    local-adapter)
      printf '按关联的本地 WTBP Skill 执行；该能力是受本地契约和门禁约束的底层能力，不单独替代流程，也不得运行 wtbp install。\n'
      ;;
    manual-optional)
      printf '仅在用户明确授权后，单独核对来源、固定版本、许可证、权限与凭据；不得运行 wtbp install 或读取凭据。\n'
      ;;
    reference-only)
      printf '仅作为方案与结构参考；需经项目设计契约或技术决策确认后才可采用。\n'
      ;;
    *)
      fail "外部能力 $capability_id 的 adoption 无法识别：$adoption"
      ;;
  esac
}

resolve_external_capabilities() {
  local query="$1"
  local matches

  matches="$(awk -F': ' -v query="$query" '
    function normalize(value) {
      value = tolower(value)
      gsub(/[[:space:]]/, "", value)
      gsub(/　/, "", value)
      return value
    }
    function scan(value, field, weight,    count,values,i,term,term_key,previous_weight) {
      gsub(/^\[/, "", value); gsub(/\]$/, "", value)
      count = split(value, values, ",")
      for (i = 1; i <= count; i++) {
        term = values[i]
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", term)
        term_key = normalize(term)
        if (term_key != "" && index(normalized_query, term_key) > 0) {
          previous_weight = term_weights[term_key] + 0
          if (weight > previous_weight) {
            score += weight - previous_weight
            term_weights[term_key] = weight
          }
          matched = matched (matched == "" ? "" : "; ") field "（" term "）"
        }
      }
    }
    function scan_exclusions(value,    count,values,i,term) {
      gsub(/^\[/, "", value); gsub(/\]$/, "", value)
      count = split(value, values, ",")
      for (i = 1; i <= count; i++) {
        term = values[i]
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", term)
        if (term != "" && index(normalized_query, normalize(term)) > 0)
          excluded = excluded (excluded == "" ? "" : ", ") term
      }
    }
    function emit() {
      if (id == "" || (status != "active" && status != "candidate")) return
      score = 0; matched = ""; excluded = ""; split("", term_weights); normalized_query = normalize(query)
      scan(solves, "solves", 4); scan(scenarios, "scenarios", 3); scan(cases, "cases", 2); scan(technologies, "technologies", 2); scan(targets, "targets", 2)
      scan(inputs, "inputs", 1); scan(outputs, "outputs", 1); scan(keywords, "keywords", 1); scan_exclusions(not_for)
      if (score > 0 && excluded == "") print score "\t" id "\t" title "\t" source_id "\t" adoption "\t" availability "\t" installation_status "\t" status "\t" matched
    }
    /^  - id: / { emit(); id = title = source_id = adoption = availability = installation_status = status = solves = not_for = scenarios = cases = inputs = outputs = technologies = targets = keywords = ""; id = $2; next }
    /^    title: / { title = $2 }
    /^    solves: / { solves = $2 }
    /^    not_for: / { not_for = $2 }
    /^    scenarios: / { scenarios = $2 }
    /^    cases: / { cases = $2 }
    /^    inputs: / { inputs = $2 }
    /^    outputs: / { outputs = $2 }
    /^    technologies: / { technologies = $2 }
    /^    targets: / { targets = $2 }
    /^    source_id: / { source_id = $2 }
    /^    adoption: / { adoption = $2 }
    /^    availability: / { availability = $2 }
    /^    installation_status: / { installation_status = $2 }
    /^    status: / { status = $2 }
    /^    keywords: \[/ { keywords = substr($0, length("    keywords: [") + 1); sub(/]$/, "", keywords) }
    END { emit() }
  ' "$external_capability_file" | sort -rn -k1,1 -k2,2)"

  [[ -n "$matches" ]] || return 0
  printf '可复用的外部能力候选（仍需当前会话作语义判断）：\n'
  while IFS=$'\t' read -r score capability_id title source_id adoption availability installation_status status matched; do
    local source_url source_publisher source_trust source_accessed_on source_license source_revision source_skill_path source_quality_evidence
    IFS=$'\t' read -r source_url source_publisher source_trust source_accessed_on source_license source_revision source_skill_path source_quality_evidence <<< "$(source_metadata "$source_id")" || true
    printf '%s\n' "- ${capability_id}（匹配 ${score}，${status}）"
    printf '  能力：%s｜采用：%s｜可用性：%s｜安装状态：%s\n' "$title" "$adoption" "$availability" "$installation_status"
    printf '  来源：%s｜发布方：%s｜可信级别：%s｜访问日期：%s\n' "$source_url" "$source_publisher" "$source_trust" "$source_accessed_on"
    printf '  命中检索字段：%s\n' "$matched"
    printf '  下一步：'
    external_next_step "$adoption" "$capability_id"
  done <<< "$matches"
}

normalise_query() {
  local query="$1"
  query="$(printf '%s' "$query" | sed -E 's/^(请|帮我|重新)?调用[[:space:]]*[Ww][Tt][Bb][Pp]([[:space:]]*(技能|[Ss]kill))?[：:,，[:space:]]*//')"
  printf '%s\n' "$query"
}

resolve_routes() {
  local query="$1"
  local matches

  query="$(normalise_query "$query")"
  [[ -n "$query" ]] || query="$1"

  matches="$(awk -v query="$query" '
    function normalize(value) {
      value = tolower(value)
      gsub(/[[:space:]]/, "", value)
      gsub(/　/, "", value)
      return value
    }
    function emit() {
      if (id == "" || (status != "active" && status != "candidate")) return
      score = 0
      matched = ""
      normalized_query = normalize(query)
      count = split(keywords, values, ",")
      for (i = 1; i <= count; i++) {
        keyword = values[i]
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", keyword)
        if (keyword != "" && index(normalized_query, normalize(keyword)) > 0) {
          score++
          matched = matched (matched == "" ? "" : ", ") keyword
        }
      }
      if (score > 0) print score "\t" id "\t" title "\t" skill "\t" source "\t" path "\t" status "\t" install "\t" auto_install "\t" matched
    }
    /^  - id: / { emit(); id = $3; title = skill = source = path = status = install = keywords = ""; auto_install = "false"; next }
    /^    title: / { title = substr($0, length("    title: ") + 1) }
    /^    skill_id: / { skill = $2 }
    /^    source: / { source = $2 }
    /^    path: / { path = $2 }
    /^    status: / { status = $2 }
    /^    install: / { install = substr($0, length("    install: ") + 1) }
    /^    auto_install: / { auto_install = $2 }
    /^    keywords: \[/ { keywords = substr($0, length("    keywords: [") + 1); sub(/]$/, "", keywords) }
    END { emit() }
  ' "$route_file" | sort -rn -k1,1 -k4,4)"

  if [[ -n "$matches" ]]; then
    printf '候选本地 Skill（按关键词匹配度排序）：\n'
    while IFS=$'\t' read -r score route_id title skill_id source path status install auto_install matched; do
      printf '%s\n' "- ${skill_id}（匹配 ${score}，${status}）"
      printf '  场景：%s\n' "$title"
      printf '  命中关键词：%s\n' "$matched"
      if [[ "$source" == local ]]; then
        printf '  下一步：读取 %s/SKILL.md；该命令不会替你执行 Skill。\n' "$path"
      elif [[ "$auto_install" == true && "$status" == active ]]; then
        printf '  安装：当前会话确认后运行 wtbp install %s；该查询不会自动安装。\n' "$skill_id"
      else
        printf '  下一步：核对来源、版本、权限和安装方式：%s；未经确认不得安装。\n' "$install"
      fi
    done <<< "$matches"
  else
    printf '未命中已登记的本地 Skill；这不等于应新建或安装 Skill。\n'
  fi

  resolve_external_capabilities "$query"
}

case "${1:-}" in
  root)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    printf '%s\n' "$repo_root"
    ;;
  list|'')
    if [[ $# -eq 0 || $# -eq 1 && "${1:-}" == list ]]; then
      list_skills
    elif [[ $# -eq 3 && "$2" == --domain ]]; then
      list_skills "$3"
    else
      usage >&2
      exit 2
    fi
    ;;
  external)
    if [[ $# -eq 1 ]]; then
      list_external_capabilities
    elif [[ $# -eq 3 && "$2" == --domain ]]; then
      list_external_capabilities "$3"
    else
      usage >&2
      exit 2
    fi
    ;;
  show)
    [[ $# -eq 2 && -n "$2" ]] || { usage >&2; exit 2; }
    show_skill "$2"
    ;;
  resolve)
    [[ $# -eq 2 && -n "$2" ]] || { usage >&2; exit 2; }
    resolve_routes "$2"
    ;;
  install)
    [[ $# -eq 2 && -n "$2" ]] || { usage >&2; exit 2; }
    bash "$repo_root/tooling/install-skill.sh" "$2"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    resolve_routes "$*"
    ;;
esac
